{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jfb-site",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // Endereço do site: sem EMDASH_SITE_URL fixo, como no CPPS. A passkey de quem
  // entra no admin fica presa ao endereço em que foi criada; a troca do
  // workers.dev para jfb.franca.unesp.br é feita pelo admin (Settings →
  // General → Change domain). Ver docs/deploy.md.

  // Banco do EmDash. Ao criar o banco (`npx wrangler d1 create jfb-site
  // --location enam`), copie o database_id para cá: o deploy a partir do build
  // do Astro não grava o ID de volta neste arquivo.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jfb-site",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],

  // Imagens e arquivos enviados pelo admin.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "jfb-site-media" }],

  // Publicação agendada, backups e manutenção do EmDash.
  "triggers": { "crons": ["* * * * *"] },

  // Logs e tempo de CPU por requisição (o plano gratuito tem limite de 10 ms).
  "observability": { "enabled": true },

  // Roda o Worker perto do banco D1 (crie o banco na região ENAM). Sem isto,
  // cada uma das dezenas de consultas por página vai e volta de São Paulo.
  "placement": { "mode": "targeted", "region": "aws:us-east-1" },
}
